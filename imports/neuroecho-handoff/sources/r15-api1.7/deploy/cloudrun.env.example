# Copy these values into the Cloud Run service environment. Never commit the
# filled-in file: the Gateway token and visitor secret are private credentials.

# The exact HTTPS URL returned by `tcb cloudrun deploy`.
XINJI_PUBLIC_ORIGIN=https://<cloudrun-service-url>

# Give every browser an independent anonymous database. This is partitioning,
# not an account system. Use a stable random value across restarts.
XINJI_VISITOR_ISOLATION=1
XINJI_VISITOR_DIR=/data/visitors
XINJI_VISITOR_SECRET=<generate-a-32-byte-random-secret>

# Text replies: the public CloudBase proxy routes to Tencent Cloud DeepSeek.
# The proxy keeps its upstream key server-side; no model key is sent to users.
XINJI_MODEL_PUBLIC=1
XINJI_MODEL_PUBLIC_MODEL=deepseek-v4-flash
XINJI_MODEL_PUBLIC_BASE_URL=https://yuntun-5g1u97p56054130d.service.tcloudbase.com/nxproxy

# Voice replies: R15 calls the HTTPS Gateway server-side. The token must never
# be placed in the Web bundle or browser settings.
NIANXIANG_TTS_ENABLED=true
NIANXIANG_TTS_PROVIDER=remote
NIANXIANG_TTS_BASE_URL=https://voice.aicloudsky.com/v1
NIANXIANG_TTS_TOKEN=<gateway-token>
NIANXIANG_TTS_PERSONA_ID=whale
NIANXIANG_TTS_TIMEOUT=120
